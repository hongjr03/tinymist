    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"Hello\"},{\"func\":\"space\"},{\"func\":\"tag\"},{\"attrs\":{\"data-typlite\":\"emph\",\"data-typlite-ir\":\"true\"},\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"{\\\"body\\\":{\\\"func\\\":\\\"text\\\",\\\"text\\\":\\\"em\\\"},\\\"func\\\":\\\"emph\\\"}\"},{\"attrs\":{\"data-typlite-field\":\"true\",\"kind\":\"content\",\"name\":\"body\"},\"body\":{\"func\":\"text\",\"text\":\"em\"},\"func\":\"elem\",\"tag\":\"span\"}],\"func\":\"sequence\"},\"func\":\"elem\",\"tag\":\"span\"},{\"func\":\"tag\"},{\"func\":\"space\"},{\"func\":\"text\",\"text\":\"and\"},{\"func\":\"space\"},{\"func\":\"tag\"},{\"attrs\":{\"data-typlite\":\"strong\",\"data-typlite-ir\":\"true\"},\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"{\\\"body\\\":{\\\"func\\\":\\\"text\\\",\\\"text\\\":\\\"strong\\\"},\\\"delta\\\":300,\\\"func\\\":\\\"strong\\\"}\"},{\"attrs\":{\"data-typlite-field\":\"true\",\"kind\":\"content\",\"name\":\"body\"},\"body\":{\"func\":\"text\",\"text\":\"strong\"},\"func\":\"elem\",\"tag\":\"span\"}],\"func\":\"sequence\"},\"func\":\"elem\",\"tag\":\"span\"},{\"func\":\"tag\"},{\"func\":\"space\"},{\"func\":\"text\",\"text\":\"and\"},{\"func\":\"space\"},{\"func\":\"tag\"},{\"bold\":false,\"child\":{\"attrs\":{\"data-typlite\":\"raw\",\"data-typlite-ir\":\"true\"},\"body\":{\"func\":\"text\",\"text\":\"{\\\"align\\\":\\\"start\\\",\\\"block\\\":false,\\\"func\\\":\\\"raw\\\",\\\"lang\\\":null,\\\"lines\\\":[{\\\"body\\\":{\\\"func\\\":\\\"text\\\",\\\"text\\\":\\\"code\\\"},\\\"count\\\":1,\\\"func\\\":\\\"line\\\",\\\"number\\\":1,\\\"text\\\":\\\"code\\\"}],\\\"syntaxes\\\":[],\\\"tab-size\\\":2,\\\"text\\\":\\\"code\\\",\\\"theme\\\":\\\"auto\\\"}\"},\"func\":\"elem\",\"tag\":\"span\"},\"cramped\":false,\"func\":\"styled\",\"italic\":null,\"size\":\"text\",\"text_fill\":\"luma(0%)\",\"text_size\":\"TextSize(8.8pt)\",\"text_style\":\"Normal\",\"text_weight\":\"400\",\"variant\":null},{\"func\":\"tag\"},{\"func\":\"text\",\"text\":\".\"}],\"func\":\"sequence\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        text "Hello"
        text " "
        tag
        <span data-typlite="emph" data-typlite-ir="true">
          text "{\"body\":{\"func\":\"text\",\"text\":\"em\"},\"func\":\"emph\"}"
          <span data-typlite-field="true" name="body" kind="content">
            text "em"
        tag
        text " "
        text "and"
        text " "
        tag
        <span data-typlite="strong" data-typlite-ir="true">
          text "{\"body\":{\"func\":\"text\",\"text\":\"strong\"},\"delta\":300,\"func\":\"strong\"}"
          <span data-typlite-field="true" name="body" kind="content">
            text "strong"
        tag
        text " "
        text "and"
        text " "
