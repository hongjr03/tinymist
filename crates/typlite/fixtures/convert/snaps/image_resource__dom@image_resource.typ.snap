---
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <body>
    tag
    <typlite-heading data-typlite-ir="true">
      text "{\"body\":{\"func\":\"text\",\"text\":\"Image Resource\"},\"bookmarked\":\"auto\",\"depth\":1,\"func\":\"heading\",\"hanging-indent\":\"auto\",\"level\":1,\"numbering\":null,\"offset\":0,\"outlined\":true,\"supplement\":{\"func\":\"text\",\"text\":\"Section\"}}"
