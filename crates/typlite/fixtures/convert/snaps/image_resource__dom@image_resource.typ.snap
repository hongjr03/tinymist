        text "Section"
      <span data-typlite-field="true" name="body" kind="content">
        text "Image Resource"
    tag
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"children\":[{\"func\":\"tag\"},{\"attrs\":{\"data-typlite\":\"image\",\"data-typlite-ir\":\"true\"},\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"{\\\"alt\\\":\\\"Sample [box]\\\",\\\"fit\\\":\\\"cover\\\",\\\"format\\\":\\\"auto\\\",\\\"func\\\":\\\"image\\\",\\\"height\\\":\\\"auto\\\",\\\"icc\\\":\\\"auto\\\",\\\"page\\\":1,\\\"scaling\\\":\\\"auto\\\",\\\"source\\\":\\\"sample.svg\\\",\\\"width\\\":\\\"auto\\\"}\"},{\"attrs\":{\"data-typlite-field\":\"true\",\"kind\":\"frame\",\"name\":\"frame\"},\"body\":{\"body\":{\"alt\":\"Sample [box]\",\"fit\":\"cover\",\"format\":\"auto\",\"func\":\"image\",\"height\":\"auto\",\"icc\":\"auto\",\"page\":1,\"scaling\":\"auto\",\"source\":\"sample.svg\",\"width\":\"auto\"},\"func\":\"frame\"},\"func\":\"elem\",\"tag\":\"span\"}],\"func\":\"sequence\"},\"func\":\"elem\",\"tag\":\"span\"},{\"func\":\"tag\"}],\"func\":\"sequence\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        tag
        <span data-typlite="image" data-typlite-ir="true">
          text "{\"alt\":\"Sample [box]\",\"fit\":\"cover\",\"format\":\"auto\",\"func\":\"image\",\"height\":\"auto\",\"icc\":\"auto\",\"page\":1,\"scaling\":\"auto\",\"source\":\"sample.svg\",\"width\":\"auto\"}"
          <span data-typlite-field="true" name="frame" kind="frame">
            frame
        tag
    tag
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-figure data-typlite-ir="true">
      text "{\"alt\":\"Figure [alt]\",\"body\":{\"alt\":\"Figure sample\",\"func\":\"image\",\"source\":\"sample.svg\"},\"caption\":{\"body\":{\"func\":\"text\",\"text\":\"Image figure\"},\"counter\":\"counter(figure.where(kind: image))\",\"func\":\"caption\",\"kind\":\"image\",\"numbering\":\"1\",\"separator\":{\"func\":\"text\",\"text\":\": \"},\"supplement\":{\"func\":\"text\",\"text\":\"Figure\"}},\"counter\":\"counter(figure.where(kind: image))\",\"func\":\"figure\",\"gap\":\"0.65em\",\"kind\":\"image\",\"numbering\":\"1\",\"outlined\":true,\"placement\":null,\"scope\":\"column\",\"supplement\":{\"func\":\"text\",\"text\":\"Figure\"}}"
      <span data-typlite-field="true" name="body" kind="content">
        tag
        <span data-typlite="image" data-typlite-ir="true">
          text "{\"alt\":\"Figure sample\",\"fit\":\"cover\",\"format\":\"auto\",\"func\":\"image\",\"height\":\"auto\",\"icc\":\"auto\",\"page\":1,\"scaling\":\"auto\",\"source\":\"sample.svg\",\"width\":\"auto\"}"
          <span data-typlite-field="true" name="frame" kind="frame">
            frame
        tag
      <span data-typlite-field="true" name="caption" kind="content">
        tag
        <span data-typlite="figure-caption" data-typlite-ir="true">
          text "{\"body\":{\"func\":\"text\",\"text\":\"Image figure\"},\"counter\":\"counter(figure.where(kind: image))\",\"func\":\"caption\",\"kind\":\"image\",\"numbering\":\"1\",\"position\":\"bottom\",\"separator\":{\"func\":\"text\",\"text\":\": \"},\"supplement\":{\"func\":\"text\",\"text\":\"Figure\"}}"
          <span data-typlite-field="true" name="body" kind="content">
            text "Image figure"
          <span data-typlite-field="true" name="supplement" kind="content">
