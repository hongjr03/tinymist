<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <body>
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"Reference citation\"},{\"func\":\"text\",\"text\":\":\"},{\"func\":\"space\"},{\"func\":\"tag\"},{\"attrs\":{\"data-typlite\":\"ref\",\"data-typlite-ir\":\"true\"},\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"{\\\"citation\\\":{\\\"func\\\":\\\"cite\\\",\\\"key\\\":\\\"<doe2020>\\\",\\\"supplement\\\":null},\\\"element\\\":null,\\\"form\\\":\\\"normal\\\",\\\"func\\\":\\\"ref\\\",\\\"supplement\\\":\\\"auto\\\",\\\"target\\\":\\\"<doe2020>\\\"}\"},{\"attrs\":{\"data-typlite-field\":\"true\",\"kind\":\"content\",\"name\":\"citation\"},\"body\":{\"func\":\"cite\",\"key\":\"<doe2020>\",\"supplement\":null},\"func\":\"elem\",\"tag\":\"span\"}],\"func\":\"sequence\"},\"func\":\"elem\",\"tag\":\"span\"},{\"func\":\"tag\"},{\"func\":\"text\",\"text\":\".\"}],\"func\":\"sequence\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        text "Reference citation"
        text ":"
        text " "
        tag
        <span data-typlite="ref" data-typlite-ir="true">
          text "{\"citation\":{\"func\":\"cite\",\"key\":\"<doe2020>\",\"supplement\":null},\"element\":null,\"form\":\"normal\",\"func\":\"ref\",\"supplement\":\"auto\",\"target\":\"<doe2020>\"}"
          <span data-typlite-field="true" name="citation" kind="content">
            tag
            <span data-typlite="cite" data-typlite-ir="true">
              text "{\"form\":\"normal\",\"func\":\"cite\",\"key\":\"<doe2020>\",\"style\":\"auto\",\"supplement\":null}"
            tag
        tag
        text "."
    tag
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"Function citation\"},{\"func\":\"text\",\"text\":\":\"},{\"func\":\"space\"},{\"func\":\"tag\"},{\"attrs\":{\"data-typlite\":\"cite\",\"data-typlite-ir\":\"true\"},\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"{\\\"form\\\":\\\"normal\\\",\\\"func\\\":\\\"cite\\\",\\\"key\\\":\\\"<doe2020>\\\",\\\"style\\\":\\\"auto\\\",\\\"supplement\\\":null}\"}],\"func\":\"sequence\"},\"func\":\"elem\",\"tag\":\"span\"},{\"func\":\"tag\"},{\"func\":\"text\",\"text\":\".\"}],\"func\":\"sequence\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        text "Function citation"
        text ":"
        text " "
        tag
        <span data-typlite="cite" data-typlite-ir="true">
          text "{\"form\":\"normal\",\"func\":\"cite\",\"key\":\"<doe2020>\",\"style\":\"auto\",\"supplement\":null}"
        tag
        text "."
