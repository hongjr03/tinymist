    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-bibliography data-typlite-ir="true">
      text "{\"full\":false,\"func\":\"bibliography\",\"sources\":[\"refs.yml\"],\"style\":\"apa\",\"title\":{\"func\":\"text\",\"text\":\"References\"}}"
      <span data-typlite-field="true" name="title" kind="content">
        text "References"
    tag
