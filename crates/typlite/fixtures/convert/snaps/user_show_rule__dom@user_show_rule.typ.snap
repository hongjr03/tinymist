  <body>
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"children\":[{\"func\":\"tag\"},{\"func\":\"tag\"},{\"attrs\":{\"data-typlite\":\"strong\",\"data-typlite-ir\":\"true\"},\"body\":{\"children\":[{\"func\":\"text\",\"text\":\"{\\\"body\\\":{\\\"func\\\":\\\"text\\\",\\\"text\\\":\\\"Title\\\"},\\\"delta\\\":300,\\\"func\\\":\\\"strong\\\"}\"},{\"attrs\":{\"data-typlite-field\":\"true\",\"kind\":\"content\",\"name\":\"body\"},\"body\":{\"func\":\"text\",\"text\":\"Title\"},\"func\":\"elem\",\"tag\":\"span\"}],\"func\":\"sequence\"},\"func\":\"elem\",\"tag\":\"span\"},{\"func\":\"tag\"},{\"func\":\"tag\"}],\"func\":\"sequence\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        tag
        tag
        <span data-typlite="strong" data-typlite-ir="true">
          text "{\"body\":{\"func\":\"text\",\"text\":\"Title\"},\"delta\":300,\"func\":\"strong\"}"
          <span data-typlite-field="true" name="body" kind="content">
            text "Title"
        tag
        tag
    tag
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"func\":\"text\",\"text\":\"Hello world.\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        text "Hello world."
    tag
