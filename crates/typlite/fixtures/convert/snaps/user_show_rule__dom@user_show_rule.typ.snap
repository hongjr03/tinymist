---
source: crates/typlite/tests/convert.rs
expression: render_debug_html(&html.root)
input_file: crates/typlite/fixtures/convert/user_show_rule.typ
---
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <body>
    <typlite-parbreak>
    tag
    <typlite-paragraph>
      <span data-typlite-field="true" name="leading" kind="length">
        text "0.65em"
      <span data-typlite-field="true" name="spacing" kind="length">
        text "1.2em"
      <span data-typlite-field="true" name="justify" kind="boolean">
        text "false"
      <span data-typlite-field="true" name="justification-limits" kind="dictionary">
        <span data-typlite-field="true" name="spacing" kind="dictionary">
          <span data-typlite-field="true" name="min" kind="relative length">
            text "66.67% + 0pt"
          <span data-typlite-field="true" name="max" kind="relative length">
            text "150% + 0pt"
        <span data-typlite-field="true" name="tracking" kind="dictionary">
          <span data-typlite-field="true" name="min" kind="length">
            text "0pt"
          <span data-typlite-field="true" name="max" kind="length">
            text "0pt"
      <span data-typlite-field="true" name="linebreaks" kind="auto">
        text "auto"
      <span data-typlite-field="true" name="first-line-indent" kind="dictionary">
        <span data-typlite-field="true" name="amount" kind="length">
          text "0pt"
        <span data-typlite-field="true" name="all" kind="boolean">
          text "false"
      <span data-typlite-field="true" name="hanging-indent" kind="length">
        text "0pt"
      <span data-typlite-field="true" name="body" kind="content">
        tag
        tag
        <span data-typlite="strong">
          <span data-typlite-field="true" name="delta" kind="integer">
            text "300"
          <span data-typlite-field="true" name="body" kind="content">
            text "Title"
        tag
        tag
    tag
