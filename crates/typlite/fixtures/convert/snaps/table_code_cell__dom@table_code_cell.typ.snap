---
source: crates/typlite/tests/convert.rs
expression: render_debug_html(&html.root)
input_file: crates/typlite/fixtures/convert/table_code_cell.typ
---
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <body>
    tag
    <typlite-table>
      <span data-typlite-field="true" name="columns" kind="array">
        <span data-typlite-field="true" name="0" kind="auto">
          text "auto"
        <span data-typlite-field="true" name="1" kind="auto">
          text "auto"
      <span data-typlite-field="true" name="rows" kind="array">
      <span data-typlite-field="true" name="gutter" kind="none">
      <span data-typlite-field="true" name="column-gutter" kind="array">
      <span data-typlite-field="true" name="row-gutter" kind="array">
      <span data-typlite-field="true" name="inset" kind="relative length">
        text "0% + 5pt"
      <span data-typlite-field="true" name="align" kind="auto">
        text "auto"
      <span data-typlite-field="true" name="fill" kind="none">
      <span data-typlite-field="true" name="stroke" kind="stroke">
        text "1pt + black"
      <span data-typlite-field="true" name="children" kind="array">
        <span data-typlite-field="true" name="0" kind="content">
          <span data-typlite="table-cell">
            <span data-typlite-field="true" name="body" kind="content">
            <span data-typlite-field="true" name="x" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="y" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="colspan" kind="integer">
              text "1"
            <span data-typlite-field="true" name="rowspan" kind="integer">
              text "1"
            <span data-typlite-field="true" name="inset" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="align" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="fill" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="stroke" kind="dictionary">
            <span data-typlite-field="true" name="breakable" kind="auto">
              text "auto"
        <span data-typlite-field="true" name="1" kind="content">
          <span data-typlite="table-cell">
            <span data-typlite-field="true" name="body" kind="content">
              tag
              <span data-typlite="raw">
                <span data-typlite-field="true" name="text" kind="string">
                  text "// Draw a circle"
                  <br>
                  text "circle((0, 0))"
                <span data-typlite-field="true" name="block" kind="boolean">
                  text "false"
                <span data-typlite-field="true" name="lang" kind="string">
                  text "typc"
                <span data-typlite-field="true" name="align" kind="alignment">
                  text "start"
                <span data-typlite-field="true" name="syntaxes" kind="array">
                <span data-typlite-field="true" name="theme" kind="auto">
                  text "auto"
                <span data-typlite-field="true" name="tab-size" kind="integer">
                  text "2"
                <span data-typlite-field="true" name="lines" kind="array">
                  <span data-typlite-field="true" name="0" kind="content">
                    tag
                    <span data-typlite="raw-line">
                      <span data-typlite-field="true" name="number" kind="integer">
                        text "1"
                      <span data-typlite-field="true" name="count" kind="integer">
                        text "2"
                      <span data-typlite-field="true" name="text" kind="string">
                        text "// Draw a circle"
                      <span data-typlite-field="true" name="body" kind="content">
                        <span style="color: #74747c">
                          text "// Draw a circle"
                    tag
                  <span data-typlite-field="true" name="1" kind="content">
                    tag
                    <span data-typlite="raw-line">
                      <span data-typlite-field="true" name="number" kind="integer">
                        text "2"
                      <span data-typlite-field="true" name="count" kind="integer">
                        text "2"
                      <span data-typlite-field="true" name="text" kind="string">
                        text "circle((0, 0))"
                      <span data-typlite-field="true" name="body" kind="content">
                        <span style="color: #4b69c6">
                          text "circle"
                        text "("
                        text "("
                        <span style="color: #b60157">
                          text "0"
                        text ","
                        text " "
                        <span style="color: #b60157">
                          text "0"
                        text ")"
                        text ")"
                    tag
              tag
            <span data-typlite-field="true" name="x" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="y" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="colspan" kind="integer">
              text "1"
            <span data-typlite-field="true" name="rowspan" kind="integer">
              text "1"
            <span data-typlite-field="true" name="inset" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="align" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="fill" kind="auto">
              text "auto"
            <span data-typlite-field="true" name="stroke" kind="dictionary">
            <span data-typlite-field="true" name="breakable" kind="auto">
              text "auto"
    tag
    <typlite-parbreak>
