---
source: crates/typlite/tests/convert.rs
expression: render_debug_html(&html.root)
input_file: crates/typlite/fixtures/convert/page_set.typ
---
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <body>
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-heading data-typlite-ir="true">
      text "{\"body\":{\"func\":\"text\",\"text\":\"Title\"},\"bookmarked\":\"auto\",\"depth\":1,\"func\":\"heading\",\"hanging-indent\":\"auto\",\"level\":1,\"numbering\":null,\"offset\":0,\"outlined\":true,\"supplement\":{\"func\":\"text\",\"text\":\"Section\"}}"
      <span data-typlite-field="true" name="supplement" kind="content">
        text "Section"
      <span data-typlite-field="true" name="body" kind="content">
        text "Title"
    tag
    <typlite-parbreak data-typlite-ir="true">
      text "{\"func\":\"parbreak\"}"
    tag
    <typlite-paragraph data-typlite-ir="true">
      text "{\"body\":{\"func\":\"text\",\"text\":\"Hello world.\"},\"first-line-indent\":{\"all\":false,\"amount\":\"0pt\"},\"func\":\"par\",\"hanging-indent\":\"0pt\",\"justification-limits\":{\"spacing\":{\"max\":\"150% + 0pt\",\"min\":\"66.67% + 0pt\"},\"tracking\":{\"max\":\"0pt\",\"min\":\"0pt\"}},\"justify\":false,\"leading\":\"0.65em\",\"linebreaks\":\"auto\",\"spacing\":\"1.2em\"}"
      <span data-typlite-field="true" name="body" kind="content">
        text "Hello world."
    tag
